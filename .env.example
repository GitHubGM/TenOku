# Copy this file to .env on the server. Never commit the real .env.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Must exactly match the URL students use, including scheme and port.
# Use http://localhost:3000 for npm start, or http://YOUR_VM_IP:8080 for Docker.
APP_ORIGIN=http://localhost:8080
# Set true when served through HTTPS. False is for local HTTP development.
COOKIE_SECURE=false
# Optional: comma-separated exact IPs of trusted reverse-proxy peers.
# Leave empty for direct access. No wildcards or CIDR ranges.
# Enable only after making the Node port inaccessible to public clients.
# Docker host Nginx may appear as a bridge gateway, not 127.0.0.1.
TRUSTED_PROXY_IPS=

# Create the first administrator on startup. Fill BOTH values before first run.
# Choose a unique password of 12-128 characters. No default account exists.
# For portable Node/Compose/Podman use, prefer a long random password made from
# letters, digits, hyphens and underscores; avoid env-file quoting differences.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: add your key only here, on the server. Never paste it into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Maximum tutor requests per account per day.
AI_DAILY_LIMIT=50
